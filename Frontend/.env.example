# Adres van de backend-API. Leeg laten voor lokaal ontwikkelen (dan wordt poort 5114 gebruikt).
VITE_API_URL=https://<jouw-app>.azurewebsites.net/api

# Gebruik internationaal formaat voor een Nederlands nummer, bijvoorbeeld 31612345678.
# Een lokaal nummer zoals 0612345678 wordt ook automatisch omgezet.
VITE_CONTACT_PHONE=31612345678
