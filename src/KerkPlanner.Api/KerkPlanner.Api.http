@host = http://localhost:5035
@token = 

### Register
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "firstName": "Piet",
  "lastName": "Jansen",
  "email": "piet@example.com",
  "phone": "06-55556666",
  "password": "geheim1"
}

### Login admin
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@kerkplanner.nl",
  "password": "admin"
}

### Login volunteer
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "jan@kerkplanner.nl",
